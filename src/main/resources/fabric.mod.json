{
	"schemaVersion": 1,
	"id": "skymyce",
	"version": "${version}",
	"name": "Sky-Myce",
	"description": "A Hypixel Skyblock QOL mod",
	"authors": [
		"mycellium, cessna808-star"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/skymyce/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "me.mycellium.skymyce.SkyMyce",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"skymyce.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"skymyce-loader": ">=${bootstrap_version}",
		"fabric-api": "*",
		"fabric-language-kotlin": "*",
		"skyblockpv": ">=1.8.9"
	}
}
