{
  "name": "sky-myce-user-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/user-bot.mjs",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs ../discord-bots/test/*.test.mjs",
    "register:user": "node --env-file-if-exists=.env ../discord-bots/src/register.mjs user",
    "register:backend": "node --env-file-if-exists=.env.backend ../discord-bots/src/register.mjs backend",
    "setup:server": "node --env-file-if-exists=.env.setup ../discord-bots/src/provision.mjs"
  },
  "dependencies": { "discord.js": "14.27.0", "ws": "8.22.0" },
  "devDependencies": { "typescript": "5.9.3" }
}
