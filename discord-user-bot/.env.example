# Required for this process only. Keep .env out of Git.
DISCORD_GUILD_ID=
USER_BOT_APPLICATION_ID=
USER_BOT_TOKEN=
# testing by default; set empty to run Discord without IRC while preparing backend.
IRC_ROOMS=testing
DISCORD_IRC_CHANNEL_ID=
DISCORD_IRC_TEST_CHANNEL_ID=
SKY_MYCE_RELAY_URL=
SKY_MYCE_RELAY_AUTH_SECRET=
# Existing relay caps text at 256 UTF-16 code units; oversized messages are rejected.
IRC_OUTBOUND_LENGTH=256
IRC_INBOUND_LENGTH=256
IRC_USER_BURST=4
IRC_USER_REFILL_MS=3000
IRC_GLOBAL_BURST=20
IRC_GLOBAL_REFILL_MS=1000
IRC_DEDUP_SIZE=1024
IRC_DEDUP_TTL_MS=300000
# Global chat shares the existing bridge implementation and Minecraft relay socket.
# Set IRC_ROOMS= for global chat only, or retain distinct legacy/testing channels.
GLOBAL_CHAT_CHANNEL_ID=
GLOBAL_CHAT_RECEIPTS_PATH=.data/global-chat-receipts.json
# Optional dedicated RNG feed; keep separate from all IRC/global channels.
# Set the same channel on the account Worker. No seven-day history backfill.
DISCORD_RNG_CHANNEL_ID=
RNG_FEED_RECEIPTS_PATH=.data/rng-feed-receipts.json
# HTTP interaction public key belongs in the Worker environment, not this process.
# Browser linking uses DISCORD_OAUTH_CLIENT_ID, DISCORD_OAUTH_CLIENT_SECRET,
# DISCORD_OAUTH_REDIRECT_URI and SKYMYCE_PUBLIC_URL on the account Worker only.
# Never load the OAuth client secret or Backend Bot token into this process.
