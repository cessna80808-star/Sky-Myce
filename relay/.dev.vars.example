# Local/staging credentials only. Copy to .dev.vars.staging (ignored).
DISCORD_GUILD_ID=<STAGING_GUILD_ID>
# Seeds the first persisted admin once; grants no license or device access.
ADMIN_BOOTSTRAP_USER_ID=<INITIAL_STAGING_ADMIN_DISCORD_ID>
DISCORD_USER_APPLICATION_ID=<USER_APPLICATION_ID>
DISCORD_USER_PUBLIC_KEY=<USER_APPLICATION_ED25519_HEX_PUBLIC_KEY>
USER_BOT_TOKEN=<USER_BOT_TOKEN>
DISCORD_BACKEND_APPLICATION_ID=<BACKEND_APPLICATION_ID>
DISCORD_BACKEND_PUBLIC_KEY=<BACKEND_APPLICATION_ED25519_HEX_PUBLIC_KEY>
DISCORD_BACKEND_BOT_TOKEN=<BACKEND_BOT_TOKEN>
# Set false only for explicitly enabled key-only DMs; accounts still remain pending.
DISCORD_LOADER_DELIVERY_ENABLED=true
DISCORD_IRC_TEST_CHANNEL_ID=<STAGING_IRC_CHANNEL_ID>
GLOBAL_CHAT_CHANNEL_ID=<DEDICATED_STAGING_CHAT_CHANNEL_ID>
DISCORD_AUDIT_CHANNEL_ID=<PRIVATE_AUDIT_CHANNEL_ID>
DISCORD_SECURITY_CHANNEL_ID=<PRIVATE_SECURITY_CHANNEL_ID>
DISCORD_LICENSE_CHANNEL_ID=<PRIVATE_LICENSE_CHANNEL_ID>
COSMETICS_COMMAND_CHANNEL=<COSMETICS_CHANNEL_ID>
DISCORD_BRIDGE_SECRET=<32_OR_MORE_RANDOM_BYTES>
DISCORD_LOADER_DOWNLOAD_SECRET=<SEPARATE_RANDOM_SECRET>
SKYMYCE_PUBLIC_URL=https://<STAGING_WORKER_HOST>
DRM_KEY_ID=staging-1
DRM_PUBLIC_KEYS={"staging-1":"<BASE64_ED25519_SPKI_PUBLIC_KEY>"}
DRM_SIGNING_PRIVATE_KEY=<BASE64_ED25519_PKCS8_PRIVATE_KEY>
LEASE_TTL_SECONDS=300
OFFLINE_GRACE_SECONDS=900
IRC_BURST=4
IRC_REFILL_SECONDS=3
IRC_GLOBAL_BURST=20
IRC_GLOBAL_REFILL_MS=1000
IRC_DEDUP_SIZE=4096
IRC_DEDUP_TTL_MS=300000
# Global chat uses the same authenticated relay; quotas apply across its rooms.
GLOBAL_CHAT_BURST=6
GLOBAL_CHAT_REFILL_SECONDS=2
GLOBAL_CHAT_MIN_INTERVAL_MS=250
GLOBAL_CHAT_DUPLICATE_MS=15000
GLOBAL_CHAT_GLOBAL_BURST=40
GLOBAL_CHAT_GLOBAL_REFILL_MS=250
GLOBAL_CHAT_MAX_PENDING=256
GLOBAL_CHAT_OUTBOX_TTL_MS=120000
GLOBAL_CHAT_MC_MAX_LENGTH=1024
GLOBAL_CHAT_DISCORD_MAX_LENGTH=4096
# Prompt intake and execution remain disabled until staging verification passes.
PROMPT_SUBMISSIONS_ENABLED=false
PROMPT_EXECUTION_VERIFIED=false
# A separate job-only credential; never reuse a Discord or account credential.
PROMPT_BRIDGE_SECRET=<SEPARATE_32_OR_MORE_RANDOM_BYTES>
PROMPT_CHANNEL_ID=<PRIVATE_PROMPT_CHANNEL_IN_CONFIGURED_GUILD>
PROMPT_PROVIDER_ACCOUNT_ID=<EXPECTED_SOL_PROVIDER_ACCOUNT_ID>
# Conservative assembled UTF-8 byte budget, independent of the provider context limit.
PROMPT_MAX_INPUT_BYTES=73728
PROMPT_BASELINE_REVISION=69542a8af0fda55ef70244110bde321bf800f022
